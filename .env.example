# Copy this file to .env (or export these as real environment variables) before running the app.

# --- Server ---
SERVER_PORT=8080

# --- Database (PostgreSQL defaults shown) ---
DB_URL=jdbc:postgresql://localhost:5432/booking_system
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- To use MySQL instead ---
# Run with: SPRING_PROFILES_ACTIVE=mysql
# DB_URL=jdbc:mysql://localhost:3306/booking_system?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

# --- JPA ---
DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---
# Must be at least 32 characters (HS256 requires a >=256-bit key)
JWT_SECRET=change-this-to-a-long-random-production-secret-value
JWT_EXPIRATION_MS=3600000
